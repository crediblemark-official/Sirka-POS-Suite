{
  "name": "sirka-monorepo",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter sirka-desktop dev",
    "build": "bun --filter sirka-desktop build && bun --filter sirka-mobile build",
    "preview": "bun --filter sirka-desktop preview",
    "dev:desktop": "bun --filter sirka-desktop dev",
    "dev:mobile": "bun --filter sirka-mobile dev",
    "build:desktop": "bun --filter sirka-desktop build",
    "build:mobile": "bun --filter sirka-mobile build",
    "tauri:desktop": "bun --filter sirka-desktop tauri dev",
    "tauri:mobile": "bun --filter sirka-mobile tauri dev",
    "tauri:android": "bun --filter sirka-mobile tauri android dev",
    "db:seed": "bun db/seed.ts",
    "test": "bun test",
    "test:rust": "cargo test --manifest-path apps/sirka-desktop/src-tauri/Cargo.toml",
    "test:all": "bun test && cargo test --manifest-path apps/sirka-desktop/src-tauri/Cargo.toml",
    "worker:dev": "cd worker && bun run dev",
    "worker:deploy": "cd worker && bun run deploy",
    "license:list": "bun run scripts/tertaut-s2s.ts list",
    "license:issue": "bun run scripts/tertaut-s2s.ts issue",
    "license:revoke": "bun run scripts/tertaut-s2s.ts revoke",
    "license:release": "bun run scripts/tertaut-s2s.ts release"
  },
  "dependencies": {
    "@sirka/shared-types": "workspace:*",
    "@sirka/shared-utils": "workspace:*",
    "@sirka/shared-core": "workspace:*",
    "@sirka/shared-ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tertaut/sdk": "^0.2.2",
    "@types/jsbarcode": "^3.11.4",
    "@types/pg": "^8.23.1",
    "@vueuse/core": "^15.0.0",
    "hono": "^4.13.13",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "lucide-vue-next": "^1.0.0",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "bun-types": "^1.4.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
