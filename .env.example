# ============================================================
# Konfigurasi lingkungan Sirka POS Suite (SALIN ke `.env` lalu sesuaikan)
# ============================================================
# CATATAN KEAMANAN & ARSITEKTUR:
#   - File `.env` SUDAH di-ignore oleh git (lihat .gitignore).
#   - Sirka POS bersifat Offline-First (Lisensi Seumur Hidup).
#   - DATABASE_URL dan konfigurasi Server dapat diisi langsung oleh pengguna
#     melalui UI Menu "Server" di aplikasi desktop maupun mobile.
#   - JANGAN pernah menulis kredensial database atau Secret Key secara literal di source code.
#   - Untuk Cloudflare Worker gunakan `wrangler secret put DATABASE_URL` & `wrangler secret put OWNER_SECRET_KEY`.

# Kredensial PostgreSQL Cloud (Opsional, untuk sinkronisasi antar perangkat)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ============================================================
# Konfigurasi Lisensi Tertaut (tertaut.com)
# ============================================================
# Klien Publik (Frontend Desktop & Mobile - terekspos di client)
# Dari kolom "PUBLISHABLE CLIENT KEY" di dashboard Tertaut
VITE_TERTAUT_PUBLISHABLE_KEY=tt_live_ganti_dengan_publishable_key_anda
# ID Aplikasi yang terdaftar di tertaut.com
VITE_TERTAUT_APP_ID=app_c0d2fecb36dd
# Base URL Tertaut (default: https://tertaut.com)
VITE_TERTAUT_BASE_URL=https://tertaut.com

# Backend S2S Secret Key (Rahasia Developer untuk otomasi penerbitan lisensi)
# JANGAN berikan awalan VITE_ agar TIDAK terekspos ke frontend bundel
TERTAUT_SECRET_KEY=tt_secret_ganti_dengan_secret_key_anda
TERTAUT_APP_ID=app_c0d2fecb36dd
TERTAUT_BASE_URL=https://tertaut.com
