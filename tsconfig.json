{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "types": ["bun-types"]
  },
  "include": [
    "tests/**/*.ts"
  ],
  "references": [
    { "path": "./packages/shared-types/tsconfig.json" },
    { "path": "./packages/shared-utils/tsconfig.json" },
    { "path": "./packages/shared-core/tsconfig.json" },
    { "path": "./packages/shared-ui/tsconfig.json" },
    { "path": "./apps/sirka-desktop/tsconfig.json" },
    { "path": "./apps/sirka-mobile/tsconfig.json" }
  ]
}
